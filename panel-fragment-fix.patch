+// decodeFragment accepts both Xray fragment files (an array/object) and a
+// complete Xray section wrapped in {"outbounds": [...]} or {"routing":{...}}.
+// This keeps panel generated node configuration from replacing user supplied
+// fragments: fragments are decoded once at core construction and remain part
+// of the immutable core configuration for the lifetime of the process.
+func decodeFragment(data []byte, section string, dst interface{}) error {
+	var value interface{}
+	if err := json.Unmarshal(data, &value); err != nil { return err }
+	if obj, ok := value.(map[string]interface{}); ok {
+		if nested, exists := obj[section]; exists {
+			value = nested
+		} else if section == "outbounds" {
+			value = []interface{}{obj}
+		}
+	}
+	normalized, err := json.Marshal(value)
+	if err != nil { return err }
+	if err := json.Unmarshal(normalized, dst); err != nil {
+		return fmt.Errorf("invalid %s fragment: %w", section, err)
+	}
+	return nil
+}
